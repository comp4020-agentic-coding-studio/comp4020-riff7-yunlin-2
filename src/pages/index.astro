---
import {
  addMinutesToTime,
  canberraParts,
  canberraWallTimeToEpochMs,
  minutesSince,
  nextReloadTargetEpochMs,
  shiftDate,
  toMinutes,
} from "../lib/clock";
import { findFreeRoom, listBookingsForDate, listRooms } from "../lib/db";
import "../styles.css";

// Riff: how long an active booking can go unconfirmed before the board
// stops trusting it — see checkedInAt in src/lib/schema.ts.
const GRACE_MINUTES = 10;

// All times on this board are Canberra wall-clock text (see src/lib/schema.ts)
// — "now" has to be read the same way, regardless of what timezone the
// machine running the server happens to be in.
const { date: today, time: nowTime } = canberraParts(new Date());
const requestedDate = Astro.url.searchParams.get("date");
const date = requestedDate && /^\d{4}-\d{2}-\d{2}$/.test(requestedDate) ? requestedDate : today;
const isToday = date === today;
const error = Astro.url.searchParams.get("error");

const errorMessages: Record<string, string> = {
  conflict: "That room is already booked for part of this time — pick another slot.",
  date: "That's not a date the board understands — pick one from the calendar.",
  invalid: "The end time has to be after the start time.",
  name: "Enter your name so the room knows who's got it.",
  room: "Pick a room.",
};

const rooms = listRooms();
const bookingsForDate = listBookingsForDate(date);
// Whether "now" falls inside a booking is decided here, in plain TS, and
// carried on the data — the Astro compiler reads a bare `<` inside a JSX-like
// expression as the start of a tag, so that comparison can't live inline in
// the template below.
const isNowWithin = (start: string, end: string) => isToday && start <= nowTime && nowTime < end;
const roomsWithBookings = rooms.map((room) => ({
  room,
  bookings: bookingsForDate
    .filter((b) => b.roomId === room.id)
    .map((b) => {
      const active = isNowWithin(b.startTime, b.endTime);
      const checkedIn = b.checkedInAt !== null;
      // "Stale" only ever applies to the live slot, never to a booking
      // whose grace period we'd have to reconstruct after the fact for a
      // past date — this board only ever asserts it about right now.
      const stale = active && !checkedIn && minutesSince(nowTime, b.startTime) >= GRACE_MINUTES;
      return { ...b, active, checkedIn, stale };
    }),
}));

// Riff: a LibCal-style availability grid — rooms as rows, 30-minute slots
// across 08:00-22:00 as real, individually clickable <button>s, replacing the
// old read-only per-room list as the board's primary view. Real library
// systems (LibCal, used across most university libraries) lay it out this
// way — rooms in rows, time in columns — so this follows that rather than
// inventing a new layout.
const GRID_START = "08:00";
const GRID_END = "22:00";
const SLOT_MINUTES = 30;
const gridStartMin = toMinutes(GRID_START);
const gridEndMin = toMinutes(GRID_END);
const slotTimes = Array.from({ length: (gridEndMin - gridStartMin) / SLOT_MINUTES }, (_, i) => {
  const start = addMinutesToTime(GRID_START, i * SLOT_MINUTES)!;
  return { start, end: addMinutesToTime(start, SLOT_MINUTES)! };
});
const gridRooms = roomsWithBookings.map(({ room, bookings }) => ({
  room,
  slots: slotTimes.map(({ start, end }) => {
    if (isToday && end <= nowTime) {
      return { start, end, status: "past" as const, label: `${room.name}, ${start}–${end}, unavailable, past` };
    }
    const hit = bookings.find((b) => start < b.endTime && end > b.startTime);
    if (hit) {
      const suffix = hit.stale ? ", unconfirmed" : hit.active ? ", now" : "";
      return {
        start,
        end,
        status: "booked" as const,
        label: `${room.name}, ${start}–${end}, booked by ${hit.bookedBy}${suffix}`,
        bookedBy: hit.bookedBy,
      };
    }
    return { start, end, status: "free" as const, label: `${room.name}, ${start}–${end}, free` };
  }),
}));
const gridNowPct =
  isToday && nowTime >= GRID_START && nowTime < GRID_END
    ? ((toMinutes(nowTime) - gridStartMin) / (gridEndMin - gridStartMin)) * 100
    : null;

// Riff: "find me a room now" — a duration in the `find` query param looks
// for a room with nothing booked between now and now-plus-that-many-minutes,
// and (if one exists) prefills the booking form with it. Only meaningful for
// today's own view; a date-nav click elsewhere drops it, same as `error`.
const findMinutesParam = Number(Astro.url.searchParams.get("find"));
const findMinutes = isToday && Number.isInteger(findMinutesParam) && findMinutesParam > 0 ? findMinutesParam : null;
const findWindowEnd = findMinutes !== null ? addMinutesToTime(nowTime, findMinutes) : null;
const foundRoom = findWindowEnd !== null ? findFreeRoom(date, nowTime, findWindowEnd) : null;
const findFailed = findMinutes !== null && foundRoom === null;

// Passed to the client script below so a tab left open across a booking's
// start/end minute — or across midnight, with no bookings left to wait for
// today — reloads itself right then, instead of only when some other tab's
// booking happens to trigger the SSE reload. A tab parked on *tomorrow*'s
// view gets the same treatment for the one boundary that matters to it: the
// moment real midnight arrives, this date stops being tomorrow and becomes
// today, so its "(today)" label and live highlighting need to switch on —
// any date further out has no near-term boundary worth waiting for.
//
// This is the real UTC instant of that boundary, not a minute count: a
// minute count handed to the client's own setTimeout would assume a
// wall-clock minute is always a real minute, which is false on the two
// nights a year Canberra's clocks shift for daylight saving (see
// canberraWallTimeToEpochMs in src/lib/clock.ts) — the client instead
// computes its own delay as target-minus-now at load time.
const nextBoundaryTarget = isToday
  ? nextReloadTargetEpochMs(date, nowTime, bookingsForDate.flatMap((b) => [b.startTime, b.endTime]))
  : date === shiftDate(today, 1)
    ? canberraWallTimeToEpochMs(date, "00:00")
    : null;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="A live board for ANU Library group study rooms — book a slot, see who's got a room right now, cancel one you don't need."
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>Room board</title>
    <script is:inline>
      // Set the theme before first paint so a returning visitor never sees a
      // flash of the wrong theme — this has to run synchronously in <head>,
      // before styles.css lays out anything the visitor would see it change.
      try {
        const saved = localStorage.getItem("theme");
        if (saved) document.documentElement.setAttribute("data-theme", saved);
      } catch {}
    </script>
  </head>
  <body>
    <nav aria-label="site">
      <a href="/">Room board</a>
      <a href="/readme/">About</a>
      <button type="button" class="theme-toggle" id="theme-toggle" aria-label="Toggle light and dark theme">
        <span aria-hidden="true">&#9788;/&#9789;</span>
      </button>
    </nav>
    <main>
      <h1>Room board</h1>
      <p>
        A shared, live view of a handful of ANU Library group study rooms: who's booked what, and what's free — see
        the <a href="/readme/">README</a> for what this prototype is standing in for.
      </p>

      <nav aria-label="date">
        <a href={`/?date=${shiftDate(date, -1)}`}>&larr; {shiftDate(date, -1)}</a>
        <strong>{date}{isToday ? " (today)" : ""}</strong>
        <a href={`/?date=${shiftDate(date, 1)}`}>{shiftDate(date, 1)} &rarr;</a>
      </nav>

      <section class="avail-grid" aria-label="room availability">
        <div class="avail-scroll">
          <div class="avail-row avail-row-header" aria-hidden="true">
            <span class="avail-label"></span>
            <div class="avail-track avail-track-header">
              {slotTimes.map(({ start }, i) => <span class="hour-label">{i % 2 === 0 ? start : ""}</span>)}
            </div>
          </div>
          {gridRooms.map(({ room, slots }) => (
            <div class="avail-row">
              <span class="avail-label">{room.name}</span>
              <div class="avail-track">
                {slots.map((slot) => (
                  <button
                    type="button"
                    class={`slot slot-${slot.status}`}
                    data-room={room.id}
                    data-start={slot.start}
                    data-end={slot.end}
                    data-status={slot.status}
                    disabled={slot.status !== "free"}
                    aria-label={slot.label}
                  >
                    {slot.status === "booked" ? slot.bookedBy : slot.status === "past" ? "×" : ""}
                  </button>
                ))}
                {gridNowPct !== null && <span class="avail-now-line" style={`left:${gridNowPct}%`} aria-hidden="true" />}
              </div>
            </div>
          ))}
        </div>
        <p class="avail-selection" id="avail-selection" hidden></p>
      </section>

      {error && (
        <p class="error" role="alert">
          {errorMessages[error] ?? "Something went wrong — try again."}
        </p>
      )}

      {isToday && (
        <nav class="find-room" aria-label="find a room now">
          <span>Find me a room now, for</span>
          <a href={`/?find=15`}>15 min</a>
          <a href={`/?find=30`}>30 min</a>
          <a href={`/?find=60`}>1 hour</a>
        </nav>
      )}

      {foundRoom && (
        <p class="notice" role="status">
          <strong>{foundRoom.name}</strong> is free right now for the next {findMinutes} minutes — filled into the
          form below, just add your name.
        </p>
      )}
      {findFailed && (
        <p class="notice" role="status">
          No room is free for the next {findMinutes} minutes right now.
        </p>
      )}

      <div class="rooms">
        {roomsWithBookings.map(({ room, bookings }, i) => (
          <section class="room" style={`--i: ${i}`} aria-labelledby={`room-${room.id}`}>
            <h2 id={`room-${room.id}`}>{room.name}</h2>
            <ul>
              {bookings.length === 0 && <li class="empty">Free all day</li>}
              {bookings.map((booking) => (
                <li class={booking.stale ? "active stale" : booking.active ? "active" : undefined}>
                  <span class="time">
                    {booking.startTime}–{booking.endTime}
                  </span>
                  <span class="who">
                    {booking.bookedBy}
                    {booking.checkedIn && (
                      <span class="badge" title="Confirmed present">
                        ✓ here
                      </span>
                    )}
                    {booking.stale && <span class="badge stale">possibly vacant</span>}
                  </span>
                  {booking.active && !booking.checkedIn && (
                    <form method="post" action={`/api/bookings/${booking.id}/checkin`}>
                      <input type="hidden" name="date" value={date} />
                      <button type="submit">I'm here</button>
                    </form>
                  )}
                  <form method="post" action={`/api/bookings/${booking.id}/cancel`}>
                    <input type="hidden" name="date" value={date} />
                    <button type="submit">{booking.stale ? "Free this slot" : "Cancel"}</button>
                  </form>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>

      <form method="post" action="/api/bookings" class="book-form">
        <h2>Book a room</h2>
        <input type="hidden" name="date" value={date} />
        <div>
          <label for="roomId">Room</label>
          <select id="roomId" name="roomId" required>
            {rooms.map((room) => (
              <option value={room.id} selected={foundRoom?.id === room.id}>
                {room.name}
              </option>
            ))}
          </select>
        </div>
        <div>
          <label for="bookedBy">Your name</label>
          <input id="bookedBy" name="bookedBy" required maxlength="80" />
        </div>
        <div>
          <label for="startTime">From</label>
          <input id="startTime" name="startTime" type="time" required value={foundRoom ? nowTime : undefined} />
        </div>
        <div>
          <label for="endTime">To</label>
          <input id="endTime" name="endTime" type="time" required value={foundRoom ? findWindowEnd : undefined} />
        </div>
        <button>Book {date}</button>
      </form>
    </main>
    <script is:inline define:vars={{ date, nextBoundaryTarget }}>
      // The board's live half: any tab looking at this same date reloads the
      // moment a booking is made or cancelled anywhere, so two people looking
      // at the same day never work from stale information. The form itself
      // needs none of this — its own POST + redirect already re-renders from
      // SQLite.
      const source = new EventSource("/api/events");
      source.addEventListener("booking", (event) => {
        const payload = JSON.parse(event.data);
        if (payload.date === date) location.reload();
      });

      // The SSE stream carries no state of its own, just a "something
      // changed" signal — so a connection that drops (a network blip, a
      // server restart on deploy) and reconnects has no way to know what it
      // missed while it was down. "open" fires on every reconnect as well as
      // the first connect; reload on every one after the first, since by
      // then the only safe assumption is that something might have changed.
      let hasOpenedBefore = false;
      source.addEventListener("open", () => {
        if (hasOpenedBefore) location.reload();
        hasOpenedBefore = true;
      });

      // The other half of "live": the "happening now" highlight and the
      // date-nav's "(today)" label are both computed once, at render time.
      // With no other tab ever booking or cancelling anything today, this
      // tab would otherwise keep showing that render's answer forever —
      // past the end of a highlighted slot, past midnight into a day this
      // render was never "today" for, or (on a tab left parked on tomorrow's
      // view) past midnight into the moment that date becomes today and
      // ought to switch its label and highlighting on. `nextBoundaryTarget`
      // (the real UTC instant of the next booking start/end today, of
      // midnight if nothing's left to wait for today, or of midnight if
      // this view is tomorrow's date) is computed server-side, correctly
      // across a Canberra daylight-saving transition — see
      // canberraWallTimeToEpochMs in src/lib/clock.ts. The client just
      // takes the delay from its own clock at load time, rather than
      // trusting a minute count computed at render time to still equal the
      // same number of real milliseconds by the time it fires.
      if (nextBoundaryTarget !== null) {
        setTimeout(() => location.reload(), Math.max(0, nextBoundaryTarget - Date.now()) + 5_000);
      }

      // Riff: turns the availability grid's free <button>s into a range
      // picker. A pivot ("anchor") is set by the first slot clicked; every
      // click or drag after that re-extends the range from that same pivot,
      // clipped to the longest run of *free* slots reachable in that
      // direction — so the selection can never cross a booked or past slot.
      // Reuses the existing booking form/endpoint rather than adding a new
      // one: picking a range just fills in the same roomId/startTime/endTime
      // fields the manual From/To fallback also writes to.
      const slotButtons = Array.from(document.querySelectorAll("button.slot"));
      const byRoom = {};
      for (const btn of slotButtons) {
        const key = btn.dataset.room;
        (byRoom[key] ??= []).push(btn);
      }
      let anchor = null;
      const selectionEl = document.getElementById("avail-selection");
      const roomSelect = document.getElementById("roomId");
      const startInput = document.getElementById("startTime");
      const endInput = document.getElementById("endTime");
      const bookedByInput = document.getElementById("bookedBy");

      function freeRun(room, fromIdx, toIdx) {
        const slots = byRoom[room];
        const dir = toIdx >= fromIdx ? 1 : -1;
        let end = fromIdx;
        for (let i = fromIdx; dir > 0 ? i <= toIdx : i >= toIdx; i += dir) {
          if (slots[i].dataset.status !== "free") break;
          end = i;
        }
        return dir > 0 ? [fromIdx, end] : [end, fromIdx];
      }

      function applyRange(room, loIdx, hiIdx) {
        const slots = byRoom[room];
        for (const btn of slotButtons) btn.classList.remove("selected");
        for (let i = loIdx; i <= hiIdx; i++) slots[i].classList.add("selected");
        const start = slots[loIdx].dataset.start;
        const end = slots[hiIdx].dataset.end;
        const roomName = slots[0].closest(".avail-row").querySelector(".avail-label").textContent;
        selectionEl.hidden = false;
        selectionEl.textContent = `${roomName}, ${start}-${end}`;
        roomSelect.value = room;
        startInput.value = start;
        endInput.value = end;
        bookedByInput?.focus();
      }

      let dragging = false;
      document.querySelectorAll(".avail-track:not(.avail-track-header)").forEach((track) => {
        track.addEventListener("mousedown", (e) => {
          const btn = e.target.closest("button.slot");
          if (!btn || btn.disabled) return;
          e.preventDefault();
          const room = btn.dataset.room;
          const idx = byRoom[room].indexOf(btn);
          if (anchor && anchor.dataset.room === room && anchor !== btn) {
            const [lo, hi] = freeRun(room, byRoom[room].indexOf(anchor), idx);
            applyRange(room, lo, hi);
          } else {
            anchor = btn;
            applyRange(room, idx, idx);
          }
          dragging = true;
        });
        track.addEventListener("mouseover", (e) => {
          if (!dragging || !anchor) return;
          const btn = e.target.closest("button.slot");
          if (!btn || btn.dataset.room !== anchor.dataset.room) return;
          const room = anchor.dataset.room;
          const [lo, hi] = freeRun(room, byRoom[room].indexOf(anchor), byRoom[room].indexOf(btn));
          applyRange(room, lo, hi);
        });
      });
      window.addEventListener("mouseup", () => {
        dragging = false;
      });

      // Theme toggle: a purely client-side preference, kept in localStorage
      // and mirrored onto <html data-theme> — the <head> script above reads
      // it back before paint on every page so it never flashes.
      const toggle = document.getElementById("theme-toggle");
      toggle?.addEventListener("click", () => {
        const current = document.documentElement.getAttribute("data-theme") ?? "dark";
        const next = current === "dark" ? "light" : "dark";
        document.documentElement.setAttribute("data-theme", next);
        try {
          localStorage.setItem("theme", next);
        } catch {}
      });
    </script>
  </body>
</html>
